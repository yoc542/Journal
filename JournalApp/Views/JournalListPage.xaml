<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.JournalListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:JournalApp.Models"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    x:Name="Page"
    x:DataType="vm:JournalListViewModel"
    Title="Journal">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Command="{Binding NewEntryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <CollectionView
            ItemsSource="{Binding Entries}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="No entries yet" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Tap New to write your first journal." Opacity="0.6" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:JournalEntry">
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference Page}}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding DisplayTitle}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Text}" FontSize="13" Opacity="0.6" MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label FontSize="11" Opacity="0.5"
                                   Text="{Binding UpdatedAt, StringFormat='{0:g}'}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="✓ Notion" FontSize="11" TextColor="#2E7D32"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsUploaded}" />
                            <Button Text="⋮" FontSize="20" Padding="8,0" BackgroundColor="Transparent" TextColor="Gray"
                                    Command="{Binding BindingContext.ShowMenuCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
