<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JournalApp.Views"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:localize="clr-namespace:JournalApp.Extensions"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NightBase}">

    <ContentPage.Resources>
        <views:NightSkyDrawable x:Key="NightSky" />
    </ContentPage.Resources>

    <Grid Background="{StaticResource NightSkyGradient}">

        <GraphicsView Drawable="{StaticResource NightSky}" InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Padding="24,12,24,30" Spacing="22">

                <VerticalStackLayout Spacing="12">
                    <Button
                        Text="{localize:Translate Settings_Back}"
                        Style="{StaticResource GhostCta}"
                        HorizontalOptions="Start"
                        Padding="4,0"
                        HeightRequest="34"
                        Command="{Binding BackCommand}" />

                    <Label Text="{localize:Translate Settings_Title}" Style="{StaticResource DisplaySmall}" />
                </VerticalStackLayout>

                <!-- ==================== Your name ==================== -->
                <VerticalStackLayout Spacing="9">
                    <Label Text="{localize:Translate Settings_Name_Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />

                    <Border Style="{StaticResource CardPanel}" StrokeShape="RoundRectangle 15" Padding="15">
                        <VerticalStackLayout Spacing="11">

                            <Label Text="{localize:Translate Settings_Name_Body}" Style="{StaticResource Caption}" FontSize="11.5" />

                            <Border Style="{StaticResource Field}">
                                <Entry
                                    Style="{StaticResource FieldEntry}"
                                    Text="{Binding UserName}"
                                    MaxLength="{Binding MaxUserNameLength}"
                                    Placeholder="{localize:Translate Settings_Name_Placeholder}"
                                    ReturnCommand="{Binding SaveNameCommand}" />
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Button
                                    Grid.Column="0"
                                    Text="{localize:Translate Settings_Name_Save}"
                                    Style="{StaticResource ChipButton}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    CornerRadius="11"
                                    Command="{Binding SaveNameCommand}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding NameNote}"
                                    Style="{StaticResource Caption}"
                                    FontSize="11.5"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasNameNote}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== Sync ==================== -->
                <VerticalStackLayout Spacing="9">
                    <Label Text="{localize:Translate Settings_Sync_Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />

                    <Border Style="{StaticResource CardPanel}" StrokeShape="RoundRectangle 15" Padding="15">
                        <VerticalStackLayout Spacing="2">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="{localize:Translate Settings_Sync_Notion}"
                                    FontFamily="KarlaRegular"
                                    FontSize="14.5"
                                    TextColor="{StaticResource Cream}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SyncStatus}"
                                    FontFamily="KarlaRegular"
                                    FontSize="11.5"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource Lilac}"
                                    Opacity="0.6">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Verdant}" />
                                            <Setter Property="Opacity" Value="0.95" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Label Text="{Binding SyncLine}" Style="{StaticResource Caption}" FontSize="11.5" />

                            <!-- Connected: the two things sync can do -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9" Margin="0,11,0,0" IsVisible="{Binding IsConnected}">
                                <Button
                                    Grid.Column="0"
                                    Text="{localize:Translate Settings_Sync_UploadNow}"
                                    Style="{StaticResource ChipButton}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    CornerRadius="11"
                                    Command="{Binding OpenUploadCommand}" />
                                <Button
                                    Grid.Column="1"
                                    Text="{localize:Translate Settings_Sync_Import}"
                                    Style="{StaticResource ChipButton}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    CornerRadius="11"
                                    Command="{Binding OpenImportCommand}" />
                            </Grid>

                            <!-- Not connected: the one thing that unlocks them -->
                            <Button
                                Text="{localize:Translate Settings_Sync_Enable}"
                                Style="{StaticResource GoldChipButton}"
                                Margin="0,11,0,0"
                                IsVisible="{Binding IsNotConnected}"
                                Command="{Binding OpenConnectCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== Access token ==================== -->
                <VerticalStackLayout Spacing="9">
                    <Label Text="{localize:Translate Settings_Token_Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />

                    <Border
                        StrokeShape="RoundRectangle 15"
                        Stroke="{StaticResource Gold}"
                        StrokeThickness="1"
                        BackgroundColor="#231D26"
                        Padding="15">
                        <VerticalStackLayout Spacing="11">

                            <Label
                                Text="{localize:Translate Settings_Token_Body}"
                                FontFamily="KarlaRegular"
                                FontSize="12.5"
                                LineHeight="1.5"
                                TextColor="{StaticResource Cream}"
                                Opacity="0.85" />

                            <Border
                                StrokeShape="RoundRectangle 11"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource NightCard}"
                                Padding="12,11">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{localize:Translate Settings_Token_Caption}" Style="{StaticResource EyebrowMuted}" FontSize="10" CharacterSpacing="1.6" />
                                    <Label
                                        Text="{Binding TokenMasked}"
                                        FontFamily="KarlaRegular"
                                        FontSize="13.5"
                                        TextColor="{StaticResource Cream}"
                                        Opacity="0.92" />
                                </VerticalStackLayout>
                            </Border>

                            <Button
                                Text="{Binding TokenActionLabel}"
                                Style="{StaticResource GoldChipButton}"
                                Command="{Binding OpenConnectCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding FooterLabel}" Style="{StaticResource Caption}" FontSize="11.5" Opacity="0.45" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
