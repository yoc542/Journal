<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.JournalEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:strings="clr-namespace:JournalApp.Resources.Strings"
    x:DataType="vm:JournalEditorViewModel"
    Title="{x:Static strings:AppResources.AppTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.History_ToolbarItem}" Command="{Binding OpenHistoryCommand}" />
        <ToolbarItem Text="{x:Static strings:AppResources.Settings_ToolbarItem}" Command="{Binding OpenSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*"
          Background="{AppThemeBinding Light={StaticResource DawnGradient}, Dark={StaticResource TwilightGradient}}">

        <VerticalStackLayout Grid.Row="0" Padding="24,28,24,12" Spacing="2">
            <Label Text="✨" FontSize="22" HorizontalOptions="Center" Opacity="0.85" />
            <Label Text="{Binding HeaderTitle}" Style="{StaticResource Headline}" />
            <Label Text="{Binding HeaderSubtitle}" Style="{StaticResource SubHeadline}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource MagicCard}" Margin="16,4,16,16">
            <Grid RowDefinitions="*,Auto">
                <Editor
                    Grid.Row="0"
                    Text="{Binding Text}"
                    MaxLength="{Binding MaxLength}"
                    Placeholder="{Binding PlaceholderText}"
                    FontSize="16"
                    AutoSize="Disabled"
                    VerticalOptions="Fill" />

                <Label
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Opacity="0.55"
                    HorizontalOptions="End"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding CharacterCountLabel}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
