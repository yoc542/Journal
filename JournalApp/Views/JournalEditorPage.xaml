<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.JournalEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:localize="clr-namespace:JournalApp.Extensions"
    x:DataType="vm:JournalEditorViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NightBase}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{StaticResource NightSkyGradient}">

        <!-- Header: back out to Today, plus the live save status -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,10,20,12">
            <Button
                Grid.Column="0"
                Text="{localize:Translate Editor_Back}"
                Style="{StaticResource GhostCta}"
                Padding="6,0"
                HeightRequest="36"
                Command="{Binding CloseCommand}" />

            <ActivityIndicator
                Grid.Column="1"
                HorizontalOptions="End"
                HeightRequest="12"
                WidthRequest="12"
                Margin="0,0,7,0"
                Color="{StaticResource Gold}"
                IsRunning="{Binding IsSaving}"
                IsVisible="{Binding IsSaving}" />

            <Label Grid.Column="2" Text="{Binding SaveStatus}" Style="{StaticResource SaveStatus}" />
        </Grid>

        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End" Color="{StaticResource Orchid}" Opacity="0.14" />

        <!-- Which page this is -->
        <VerticalStackLayout Grid.Row="1" Padding="24,20,24,6" Spacing="4">
            <Label Text="{Binding DateLabel}" Style="{StaticResource Eyebrow}" FontSize="10" Opacity="0.7" />
            <Label Text="{Binding HeaderTitle}" Style="{StaticResource DisplaySmall}" FontSize="26" />
        </VerticalStackLayout>

        <!-- The page itself -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="20,10,20,0" Padding="6,0">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" ColumnSpacing="9" Padding="0,0,0,10">
                <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center" Color="{StaticResource GoldDeep}" Opacity="0.45" />
                <Label Grid.Column="1" Text="❧" FontSize="10" TextColor="{StaticResource GoldDeep}" Opacity="0.85" />
                <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" Color="{StaticResource GoldDeep}" Opacity="0.45" />
            </Grid>

            <Editor
                Grid.Row="1"
                Style="{StaticResource EditorBody}"
                Text="{Binding Text}"
                MaxLength="{Binding MaxLength}"
                Placeholder="{Binding PlaceholderText}"
                VerticalOptions="Fill" />
        </Grid>

        <!-- Footer: word count and the two page actions -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="22,12,22,20" BackgroundColor="{StaticResource NightVeil}">
            <Label
                Grid.Column="0"
                Text="{Binding WordCountLabel}"
                Style="{StaticResource Caption}"
                FontSize="11.5"
                VerticalOptions="Center" />

            <HorizontalStackLayout Grid.Column="1" Spacing="9">
                <Button
                    Text="{localize:Translate Editor_Close}"
                    Style="{StaticResource FooterGhostCta}"
                    Command="{Binding CloseCommand}" />
                <Button
                    Text="{localize:Translate Menu_UploadToNotion}"
                    Style="{StaticResource FooterCta}"
                    Command="{Binding UploadCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            </HorizontalStackLayout>
        </Grid>

        <BoxView Grid.Row="3" HeightRequest="1" VerticalOptions="Start" Color="{StaticResource Orchid}" Opacity="0.14" />
    </Grid>
</ContentPage>
