<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JournalApp.Views"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:localize="clr-namespace:JournalApp.Extensions"
    x:DataType="vm:OnboardingViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NightBase}">

    <ContentPage.Resources>
        <views:NightSkyDrawable x:Key="NightSky" />
    </ContentPage.Resources>

    <Grid Background="{StaticResource NightSkyGradient}">

        <GraphicsView Drawable="{StaticResource NightSky}" InputTransparent="True" />

        <!-- ==================== Welcome ==================== -->
        <Grid IsVisible="{Binding IsWelcome}" RowDefinitions="*,Auto" Padding="30,40,30,46">

            <VerticalStackLayout Grid.Row="0" Spacing="16" VerticalOptions="End">

                <Border
                    HeightRequest="74"
                    WidthRequest="74"
                    HorizontalOptions="Start"
                    StrokeShape="RoundRectangle 37"
                    Stroke="{StaticResource Gold}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource NightHaze}">
                    <Label
                        Text="✦"
                        FontFamily="CormorantSemiBold"
                        FontSize="32"
                        TextColor="{StaticResource Cream}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label Text="{localize:Translate Onboarding_Welcome_Title}" Style="{StaticResource Display}" />

                <BoxView HeightRequest="1" WidthRequest="120" HorizontalOptions="Start" Color="{StaticResource GoldDeep}" Opacity="0.75" />

                <Label
                    Text="{localize:Translate Onboarding_Welcome_Body}"
                    Style="{StaticResource Body}"
                    MaximumWidthRequest="290" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,26,0,0">
                <Button
                    Text="{localize:Translate Onboarding_Welcome_Begin}"
                    Style="{StaticResource PrimaryCta}"
                    Command="{Binding BeginCommand}" />
                <Button
                    Text="{localize:Translate Onboarding_Welcome_Existing}"
                    Style="{StaticResource SecondaryCta}"
                    Command="{Binding ExistingCommand}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ==================== Step 1: profile ==================== -->
        <ScrollView IsVisible="{Binding IsProfile}">
            <Grid RowDefinitions="Auto,*,Auto" Padding="26,20,26,34" RowSpacing="24">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        FontSize="20"
                        WidthRequest="38"
                        HeightRequest="38"
                        Padding="0"
                        Style="{StaticResource SecondaryCta}"
                        Command="{Binding BackCommand}" />

                    <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6" VerticalOptions="Center">
                        <BoxView Grid.Column="0" HeightRequest="3" CornerRadius="2" Color="{StaticResource Gold}" />
                        <BoxView Grid.Column="1" HeightRequest="3" CornerRadius="2" Color="{StaticResource Orchid}" Opacity="0.3" />
                    </Grid>

                    <Label Grid.Column="2" Text="{Binding StepLabel}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="22">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{localize:Translate Onboarding_Setup_Eyebrow}" Style="{StaticResource Eyebrow}" />
                        <Label Text="{localize:Translate Onboarding_Profile_Title}" Style="{StaticResource DisplaySmall}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{localize:Translate Onboarding_Name_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry
                                Style="{StaticResource FieldEntry}"
                                Text="{Binding Name}"
                                Placeholder="{localize:Translate Onboarding_Name_Placeholder}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{localize:Translate Onboarding_Reminder_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource CardPanel}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                    <Label
                                        Text="{localize:Translate Onboarding_Reminder_Title}"
                                        FontFamily="KarlaRegular"
                                        FontSize="15"
                                        TextColor="{StaticResource Cream}" />
                                    <Label Text="{localize:Translate Onboarding_Reminder_Body}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Switch
                                    Grid.Column="1"
                                    Style="{StaticResource NightSwitch}"
                                    IsToggled="{Binding ReminderEnabled}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Button
                    Grid.Row="2"
                    Text="{localize:Translate Onboarding_Continue}"
                    Style="{StaticResource PrimaryCta}"
                    Command="{Binding ContinueCommand}" />
            </Grid>
        </ScrollView>

        <!-- ==================== Step 2: Notion token ==================== -->
        <ScrollView IsVisible="{Binding IsToken}">
            <Grid RowDefinitions="Auto,*,Auto" Padding="26,20,26,34" RowSpacing="20">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        FontSize="20"
                        WidthRequest="38"
                        HeightRequest="38"
                        Padding="0"
                        Style="{StaticResource SecondaryCta}"
                        Command="{Binding BackCommand}" />

                    <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6" VerticalOptions="Center">
                        <BoxView Grid.Column="0" HeightRequest="3" CornerRadius="2" Color="{StaticResource Gold}" />
                        <BoxView Grid.Column="1" HeightRequest="3" CornerRadius="2" Color="{StaticResource Gold}" />
                    </Grid>

                    <Label Grid.Column="2" Text="{Binding StepLabel}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="20">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{localize:Translate Onboarding_Token_Eyebrow}" Style="{StaticResource Eyebrow}" />
                        <Label Text="{localize:Translate Onboarding_Token_Title}" Style="{StaticResource DisplaySmall}" />
                        <Label Text="{localize:Translate Onboarding_Token_Body}" Style="{StaticResource Body}" FontSize="13.5" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="{localize:Translate Onboarding_Token_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry
                                Style="{StaticResource FieldEntry}"
                                Text="{Binding Token}"
                                IsPassword="True"
                                IsEnabled="{Binding IsNotBusy}"
                                Placeholder="{localize:Translate Settings_Token_Placeholder}" />
                        </Border>
                        <Label Text="{localize:Translate Onboarding_Token_Help}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding HasError}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource EmberDeep}"
                        StrokeThickness="1"
                        BackgroundColor="#3A1E28"
                        Padding="14,12">
                        <Label
                            Text="{Binding ErrorMessage}"
                            FontFamily="KarlaRegular"
                            FontSize="13"
                            LineHeight="1.4"
                            TextColor="{StaticResource Ember}" />
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Gold}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="2" Spacing="10">
                    <Button
                        Text="{localize:Translate Onboarding_Token_Connect}"
                        Style="{StaticResource PrimaryCta}"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                    <Button
                        Text="{localize:Translate Onboarding_Token_Skip}"
                        Style="{StaticResource SecondaryCta}"
                        Command="{Binding SkipCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                    <Label
                        Text="{localize:Translate Onboarding_Token_SkipHint}"
                        Style="{StaticResource Caption}"
                        FontSize="11.5"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- ==================== Done ==================== -->
        <Grid IsVisible="{Binding IsDone}" RowDefinitions="*,Auto" Padding="30,40,30,40">

            <VerticalStackLayout Grid.Row="0" Spacing="22" VerticalOptions="Center">

                <Border
                    HeightRequest="96"
                    WidthRequest="96"
                    HorizontalOptions="Start"
                    StrokeShape="RoundRectangle 48"
                    Stroke="{StaticResource Gold}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource NightHaze}">
                    <Label
                        Text="✓"
                        FontSize="34"
                        TextColor="{StaticResource Gold}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding DoneTitle}" Style="{StaticResource DisplaySmall}" FontSize="36" />
                <Label Text="{Binding DoneBody}" Style="{StaticResource Body}" FontSize="14.5" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="11">
                <Button
                    Text="{localize:Translate Onboarding_Done_Write}"
                    Style="{StaticResource PrimaryCta}"
                    Command="{Binding FinishCommand}" />
                <Button
                    Text="{localize:Translate Onboarding_Done_Settings}"
                    Style="{StaticResource SecondaryCta}"
                    Command="{Binding OpenSettingsCommand}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
