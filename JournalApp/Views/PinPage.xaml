<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.PinPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JournalApp.Views"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:localize="clr-namespace:JournalApp.Extensions"
    x:DataType="vm:PinViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NightBase}">

    <ContentPage.Resources>
        <views:NightSkyDrawable x:Key="NightSky" />
    </ContentPage.Resources>

    <Grid Background="{StaticResource NightSkyGradient}">

        <GraphicsView Drawable="{StaticResource NightSky}" InputTransparent="True" />

        <ScrollView>
            <Grid RowDefinitions="Auto,Auto,Auto" Padding="26,20,26,26" RowSpacing="16">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        FontSize="20"
                        WidthRequest="38"
                        HeightRequest="38"
                        Padding="0"
                        Style="{StaticResource SecondaryCta}"
                        Command="{Binding BackCommand}" />

                    <Label
                        Grid.Column="2"
                        Text="{localize:Translate Pin_Step_Settings}"
                        Style="{StaticResource Caption}"
                        VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="9">
                    <Label Text="{Binding Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />
                    <Label Text="{Binding Title}" Style="{StaticResource DisplaySmall}" FontSize="31" />
                    <Label Text="{Binding Body}" Style="{StaticResource Body}" FontSize="13" />
                </VerticalStackLayout>

                <views:PinPad
                    Grid.Row="2"
                    FilledCount="{Binding EnteredLength}"
                    ErrorMessage="{Binding ErrorMessage}"
                    KeyCommand="{Binding KeyCommand}" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
