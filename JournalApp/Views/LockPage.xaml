<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.LockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JournalApp.Views"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:localize="clr-namespace:JournalApp.Extensions"
    x:DataType="vm:LockViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NightBase}">

    <ContentPage.Resources>
        <views:NightSkyDrawable x:Key="NightSky" />
    </ContentPage.Resources>

    <Grid Background="{StaticResource NightSkyGradient}">

        <GraphicsView Drawable="{StaticResource NightSky}" InputTransparent="True" />

        <Grid RowDefinitions="*,Auto" Padding="26,26,26,30" RowSpacing="16">

            <VerticalStackLayout Grid.Row="0" Spacing="16" VerticalOptions="Center">

                <Border
                    HeightRequest="74"
                    WidthRequest="74"
                    HorizontalOptions="Start"
                    StrokeShape="RoundRectangle 37"
                    Stroke="{StaticResource Gold}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource NightHaze}">
                    <Label
                        Text="✦"
                        FontSize="26"
                        TextColor="{StaticResource Gold}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Greeting}" Style="{StaticResource DisplaySmall}" FontSize="33" />
                    <Label Text="{localize:Translate Lock_Body}" Style="{StaticResource Body}" FontSize="13.5" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <views:PinPad
                Grid.Row="1"
                FilledCount="{Binding EnteredLength}"
                ErrorMessage="{Binding ErrorMessage}"
                KeyCommand="{Binding KeyCommand}" />
        </Grid>
    </Grid>
</ContentPage>
