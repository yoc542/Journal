<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JournalApp.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JournalApp.Views"
    xmlns:vm="clr-namespace:JournalApp.ViewModels"
    xmlns:localize="clr-namespace:JournalApp.Extensions"
    x:Name="Page"
    x:DataType="vm:ImportViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource NightBase}">

    <ContentPage.Resources>
        <views:NightSkyDrawable x:Key="NightSky" />
    </ContentPage.Resources>

    <Grid Background="{StaticResource NightSkyGradient}">

        <GraphicsView Drawable="{StaticResource NightSky}" InputTransparent="True" />

        <!-- ==================== Notion not connected ==================== -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsNotConnected}">
            <Button
                Grid.Row="0"
                Text="{localize:Translate Import_Back}"
                Style="{StaticResource GhostCta}"
                HorizontalOptions="Start"
                Margin="22,12,0,0"
                Padding="4,0"
                HeightRequest="34"
                Command="{Binding BackCommand}" />

            <VerticalStackLayout Grid.Row="1" Padding="30,0,30,60" Spacing="16" VerticalOptions="Center">
                <Label Text="{localize:Translate Import_Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />
                <Label Text="{localize:Translate Notion_NotConnected_Title}" Style="{StaticResource DisplaySmall}" />
                <Label Text="{localize:Translate Notion_NotConnected_Body}" Style="{StaticResource Body}" FontSize="14" />
                <Button
                    Text="{localize:Translate Notion_Connect_Cta}"
                    Style="{StaticResource PrimaryCta}"
                    Margin="0,6,0,0"
                    Command="{Binding ConnectCommand}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ==================== Scanning ==================== -->
        <VerticalStackLayout IsVisible="{Binding IsScanning}" Padding="24,12,24,20" Spacing="12">

            <Button
                Text="{localize:Translate Import_Back}"
                Style="{StaticResource GhostCta}"
                HorizontalOptions="Start"
                Padding="4,0"
                HeightRequest="34"
                Command="{Binding BackCommand}" />

            <VerticalStackLayout Spacing="7" Margin="0,0,0,8">
                <Label Text="{localize:Translate Import_Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />
                <Label Text="{localize:Translate Import_Heading_Scanning}" Style="{StaticResource DisplaySmall}" FontSize="30" />
            </VerticalStackLayout>

            <ProgressBar
                IsVisible="True"
                Progress="0.4"
                ProgressColor="{StaticResource Orchid}"
                BackgroundColor="{StaticResource NightHaze}"
                HeightRequest="4" />

            <Label Text="{localize:Translate Import_Scanning_Label}" Style="{StaticResource Caption}" FontSize="12.5" />

            <!-- Placeholder rows standing in for the pages still being read -->
            <VerticalStackLayout Spacing="9">
                <Border HeightRequest="58" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource NightCard}" Opacity="0.5" />
                <Border HeightRequest="58" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource NightCard}" Opacity="0.38" />
                <Border HeightRequest="58" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{StaticResource NightCard}" Opacity="0.26" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- ==================== Pick what to bring in ==================== -->
        <Grid IsVisible="{Binding IsPicker}" RowDefinitions="Auto,*,Auto">

            <VerticalStackLayout Grid.Row="0" Padding="24,12,24,14" Spacing="12">
                <Button
                    Text="{localize:Translate Import_Back}"
                    Style="{StaticResource GhostCta}"
                    HorizontalOptions="Start"
                    Padding="4,0"
                    HeightRequest="34"
                    Command="{Binding BackCommand}" />

                <VerticalStackLayout Spacing="7">
                    <Label Text="{localize:Translate Import_Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />
                    <Label Text="{Binding Heading}" Style="{StaticResource DisplaySmall}" FontSize="30" />
                    <Label Text="{Binding Subheading}" Style="{StaticResource Body}" FontSize="13" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" Margin="24,0">
                <VerticalStackLayout Spacing="9" BindableLayout.ItemsSource="{Binding Incoming}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:IncomingEntry">
                            <Border Style="{StaticResource EntryRow}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.ToggleSelectionCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="20,*" ColumnSpacing="12">

                                    <Border
                                        Grid.Column="0"
                                        VerticalOptions="Start"
                                        Margin="0,2,0,0"
                                        HeightRequest="20"
                                        WidthRequest="20"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{StaticResource Gold}"
                                        StrokeThickness="1"
                                        BackgroundColor="Transparent">
                                        <Label
                                            Text="{Binding CheckMark}"
                                            FontSize="12"
                                            TextColor="{StaticResource Gold}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label
                                            Text="{Binding DateLabel}"
                                            FontFamily="KarlaSemiBold"
                                            FontSize="14"
                                            TextColor="{StaticResource Cream}" />
                                        <Label
                                            Text="{Binding Title}"
                                            Style="{StaticResource Caption}"
                                            FontSize="12"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding FlagLabel}" FontSize="10.5" TextColor="{StaticResource Orchid}" Opacity="0.8">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsConflict}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Gold}" />
                                                    <Setter Property="Opacity" Value="0.9" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <Button
                Grid.Row="2"
                Text="{Binding ImportButtonLabel}"
                Style="{StaticResource PrimaryCta}"
                Margin="24,12,24,26"
                FontSize="15.5"
                HeightRequest="52"
                Command="{Binding ConfirmCommand}" />
        </Grid>

        <!-- ==================== One conflict at a time ==================== -->
        <ScrollView IsVisible="{Binding IsConflict}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="24,12,24,30" RowSpacing="16">

                <Button
                    Grid.Row="0"
                    Text="{localize:Translate Conflict_Back}"
                    Style="{StaticResource GhostCta}"
                    HorizontalOptions="Start"
                    Padding="4,0"
                    HeightRequest="34"
                    Command="{Binding BackToPickerCommand}" />

                <VerticalStackLayout Grid.Row="1" Spacing="7">
                    <Label Text="{Binding ConflictEyebrow}" Style="{StaticResource Eyebrow}" FontSize="10" />
                    <Label Text="{Binding ConflictTitle}" Style="{StaticResource DisplaySmall}" FontSize="28" />
                    <Label Text="{localize:Translate Conflict_Body}" Style="{StaticResource Body}" FontSize="13" />
                </VerticalStackLayout>

                <!-- The two versions, side by side vertically -->
                <VerticalStackLayout Grid.Row="2" Spacing="10">
                    <Border Style="{StaticResource CardPanel}" StrokeShape="RoundRectangle 14" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding LocalWords}" Style="{StaticResource EyebrowMuted}" FontSize="10" Opacity="0.6" />
                            <Label Text="{Binding LocalPreview}" FontFamily="CormorantRegular" FontSize="15.5" LineHeight="1.5" TextColor="{StaticResource Cream}" Opacity="0.9" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 14" Stroke="{StaticResource Gold}" StrokeThickness="1" BackgroundColor="#241E22" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding IncomingWords}" Style="{StaticResource Eyebrow}" FontSize="10" CharacterSpacing="1.6" />
                            <Label Text="{Binding IncomingPreview}" FontFamily="CormorantRegular" FontSize="15.5" LineHeight="1.5" TextColor="{StaticResource Cream}" Opacity="0.9" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- What to do about it -->
                <VerticalStackLayout Grid.Row="3" Spacing="8">

                    <Border Style="{StaticResource ChoiceRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickCommand}" CommandParameter="{x:Static vm:ConflictChoice.Device}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="11">
                            <Border Grid.Column="0" Style="{StaticResource ChoiceDot}">
                                <Label Text="●" FontSize="11" TextColor="{StaticResource Gold}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsKeepDevice}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{localize:Translate Conflict_Choice_Device}" Style="{StaticResource TileTitle}" FontSize="14" />
                                <Label Text="{localize:Translate Conflict_Choice_Device_Note}" Style="{StaticResource Caption}" FontSize="11.5" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ChoiceRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickCommand}" CommandParameter="{x:Static vm:ConflictChoice.Incoming}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="11">
                            <Border Grid.Column="0" Style="{StaticResource ChoiceDot}">
                                <Label Text="●" FontSize="11" TextColor="{StaticResource Gold}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsUseNotion}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{localize:Translate Conflict_Choice_Incoming}" Style="{StaticResource TileTitle}" FontSize="14" />
                                <Label Text="{localize:Translate Conflict_Choice_Incoming_Note}" Style="{StaticResource Caption}" FontSize="11.5" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ChoiceRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickCommand}" CommandParameter="{x:Static vm:ConflictChoice.Both}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="18,*" ColumnSpacing="11">
                            <Border Grid.Column="0" Style="{StaticResource ChoiceDot}">
                                <Label Text="●" FontSize="11" TextColor="{StaticResource Gold}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsKeepBoth}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{localize:Translate Conflict_Choice_Both}" Style="{StaticResource TileTitle}" FontSize="14" />
                                <Label Text="{localize:Translate Conflict_Choice_Both_Note}" Style="{StaticResource Caption}" FontSize="11.5" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Apply to the rest -->
                <Grid Grid.Row="4" ColumnDefinitions="18,*" ColumnSpacing="9">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleApplyToAllCommand}" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0" Style="{StaticResource ChoiceDot}" StrokeShape="RoundRectangle 5">
                        <Label Text="{Binding ApplyToAllMark}" FontSize="11" TextColor="{StaticResource Gold}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{localize:Translate Conflict_ApplyAll}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                </Grid>

                <Grid Grid.Row="6" ColumnDefinitions="96,*" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="{localize:Translate Conflict_Skip}"
                        Style="{StaticResource SecondaryCta}"
                        HeightRequest="52"
                        CornerRadius="13"
                        Command="{Binding SkipConflictCommand}" />
                    <Button
                        Grid.Column="1"
                        Text="{localize:Translate Conflict_Resolve}"
                        Style="{StaticResource PrimaryCta}"
                        FontSize="15.5"
                        HeightRequest="52"
                        CornerRadius="13"
                        Command="{Binding ResolveCommand}" />
                </Grid>
            </Grid>
        </ScrollView>

        <!-- ==================== Done ==================== -->
        <VerticalStackLayout IsVisible="{Binding IsDone}" Padding="30,0,30,50" Spacing="20" VerticalOptions="Center">

            <Border
                HeightRequest="88"
                WidthRequest="88"
                HorizontalOptions="Start"
                StrokeShape="RoundRectangle 44"
                Stroke="{StaticResource Verdant}"
                StrokeThickness="1"
                BackgroundColor="#1E2A26">
                <Label Text="✓" FontSize="32" TextColor="{StaticResource Verdant}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding DoneTitle}" Style="{StaticResource DisplaySmall}" FontSize="34" />
            <Label Text="{Binding DoneBody}" Style="{StaticResource Body}" FontSize="14" />

            <VerticalStackLayout Spacing="10">
                <Button
                    Text="{localize:Translate ImportDone_History}"
                    Style="{StaticResource PrimaryCta}"
                    FontSize="15.5"
                    HeightRequest="52"
                    CornerRadius="13"
                    Command="{Binding OpenHistoryCommand}" />
                <Button
                    Text="{localize:Translate ImportDone_Today}"
                    Style="{StaticResource SecondaryCta}"
                    HeightRequest="48"
                    CornerRadius="13"
                    Command="{Binding OpenTodayCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
