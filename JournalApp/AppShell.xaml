<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JournalApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JournalApp.Views"
    Title="Journal"
    FlyoutBehavior="Disabled">

    <ShellContent
        x:Name="LockShell"
        Title="Journal"
        ContentTemplate="{DataTemplate views:LockPage}"
        Route="LockPage" />

    <ShellContent
        x:Name="OnboardingShell"
        Title="Journal"
        ContentTemplate="{DataTemplate views:OnboardingPage}"
        Route="OnboardingPage" />

    <ShellContent
        x:Name="TodayShell"
        Title="Journal"
        ContentTemplate="{DataTemplate views:TodayPage}"
        Route="TodayPage" />

</Shell>
